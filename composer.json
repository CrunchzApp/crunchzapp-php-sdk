{
    "name": "crunchzapp/crunchzapp-php-sdk",
    "description": "Official PHP SDK for CrunchzApp WhatsApp Business API - Send messages, manage contacts, groups, and OTP verification",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "whatsapp",
        "api",
        "sdk",
        "crunchzapp",
        "messaging",
        "otp",
        "laravel",
        "php"
    ],
    "homepage": "https://crunchz.app",
    "support": {
        "issues": "https://github.com/crunchzapp/crunchzapp-php-sdk/issues",
        "source": "https://github.com/crunchzapp/crunchzapp-php-sdk",
        "docs": "https://docs.crunchz.app"
    },
    "authors": [
        {
            "name": "Rafi Halilintar",
            "email": "masitingss@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/http": "^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "CrunchzApp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CrunchzApp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CrunchzApp\\CrunchzAppServiceProvider"
            ],
            "aliases": {
                "CrunchzApp": "CrunchzApp\\CrunchzApp"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
